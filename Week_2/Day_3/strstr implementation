class Solution {
    public int strStr(String haystack, String needle) {

        int n = haystack.length();
        int m = needle.length();

        if (m == 0) {
            return 0;
        }

        int[] lps = new int[m];

        // Build LPS Array
        int len = 0;
        int i = 1;

        while (i < m) {

            if (needle.charAt(i) == needle.charAt(len)) {
                len++;
                lps[i] = len;
                i++;
            } else {

                if (len != 0) {
                    len = lps[len - 1];
                } else {
                    lps[i] = 0;
                    i++;
                }
            }
        }
        int p1 = 0; // haystack pointer
        int p2 = 0; // needle pointer

        while (p1 < n) {

            if (haystack.charAt(p1) == needle.charAt(p2)) {
                p1++;
                p2++;
            }

            if (p2 == m) {
                return p1 - m;
            }

            else if (p1 < n &&
                     haystack.charAt(p1) != needle.charAt(p2)) {

                if (p2 != 0) {
                    p2 = lps[p2 - 1];
                } else {
                    p1++;
                }
            }
        }

        return -1;
    }
}
