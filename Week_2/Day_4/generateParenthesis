class Solution {
    public List<String> generateParenthesis(int n) {
        List<String>ans=new ArrayList<>();
        solve(ans,"",0,0,n);
        return ans;
    }
    public void solve(List<String>ans,String str, int open,int end,int n){
        if(str.length()==2*n){
            ans.add(str);
            return;
        }
        if(open<n){
            solve(ans,str+"(",open+1,end,n);
        }
         if(end<open){
            solve(ans,str+")",open,end+1,n);
        }
    }
}
