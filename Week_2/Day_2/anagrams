import java.util.*;

class Solution {
    public List<Integer> findAnagrams(String s, String p) {
        int n = p.length();
        int m = s.length();
        List<Integer> result = new ArrayList<>();

        if (n > m) {
            return result;
        }

        int[] count1 = new int[26];
        int[] count2 = new int[26];

        for (int i = 0; i < n; i++) {
            count1[p.charAt(i) - 'a']++;
        }

        for (int i = 0; i < m; i++) {

            count2[s.charAt(i) - 'a']++;

            if (i >= n) {
                count2[s.charAt(i - n) - 'a']--;
            }

            if (Arrays.equals(count1, count2)) {
                result.add(i - n + 1);
            }
        }

        return result;
    }
}
