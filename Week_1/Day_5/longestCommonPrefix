class Solution {
    public String longestCommonPrefix(String[] strs) {
        String init = strs[0];
        for(int i=0;i<init.length();i++){
            char ch=init.charAt(i);
            for(int j=1;j<strs.length;j++){
                if(i>=strs[j].length() || strs[j].charAt(i)!=ch){
                    return init.substring(0,i);

                }
            }
        }return init;
    }
}
