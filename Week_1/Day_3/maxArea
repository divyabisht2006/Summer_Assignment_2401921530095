class Solution {
    public int maxArea(int[] height) {

        int start = 0;
        int end = height.length - 1;

        int answer = 0;

        while (start < end) {

            int distance = end - start;

            int waterStored = distance * Math.min(height[start], height[end]);

            if (waterStored > answer) {
                answer = waterStored;
            }

            if (height[start] <= height[end]) {
                start++;
            } else {
                end--;
            }
        }

        return answer;
    }
}
