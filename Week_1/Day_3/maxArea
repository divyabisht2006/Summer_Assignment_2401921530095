class Solution {
    public int maxArea(int[] height) {
        int start = 0;
        int end = height.length - 1;
        int ans = 0;
        while (start < end) {
            int dis = end - start;
            int waterStored = dis* Math.min(height[start], height[end]);
            if (waterStored > ans) {
                ans = waterStored;
            }
            if (height[start] <= height[end]) {
                start++;
            } else {
                end--;
            }
        }

        return ans;
    }
}
