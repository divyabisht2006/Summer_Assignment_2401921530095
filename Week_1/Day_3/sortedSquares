class Solution {
    public int[] sortedSquares(int[] nums) {
        int n= nums.length;
        int[]result=new int[n];
        int start=0;
        int pos=n-1;
        int end=n-1;
        while(start<=end){
            int leftvalue=nums[start]*nums[start];
              int rgtvalue=nums[end]*nums[end];
              if(leftvalue>=rgtvalue){
                result[pos]=leftvalue;
                start++;
              }else{
                result[pos]=rgtvalue;
                end--;
              }
             pos--;
        }
           return result;
    }
}
