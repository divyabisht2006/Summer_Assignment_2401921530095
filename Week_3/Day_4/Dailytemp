import java.util.Stack;

class Solution {
    public int[] dailyTemperatures(int[] temp) {

        int n = temp.length;
        int[] res = new int[n];

        Stack<Integer> stack = new Stack<>();

        for (int curr = 0; curr < n; curr++) {

            while (!stack.isEmpty() &&
                   temp[curr] > temp[stack.peek()]) {

                int previous = stack.pop();
                res[previous] = curr - previous;
            }

            stack.push(curr);
        }

        return res;
    }
}
