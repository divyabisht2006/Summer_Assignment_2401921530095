import java.util.*;

class RecentCounter {

    Queue<Integer> q;

    public RecentCounter() {
        q = new LinkedList<>();
    }

    public int ping(int t) {

        q.offer(t);

        while (!q.isEmpty()) {

            if (q.peek() < t - 3000) {
                q.poll();
            } else {
                break;
            }
        }

        return q.size();
    }
}
