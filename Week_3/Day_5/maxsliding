import java.util.*;

class Solution {

    public int[] maxSlidingWindow(int[] nums, int k) {

        int n = nums.length;
        int[] ans = new int[n - k + 1];

        Deque<Integer> dq = new LinkedList<>();

        int idx = 0;

        for (int i = 0; i < n; i++) {

            while (!dq.isEmpty()) {

                if (dq.peekFirst() <= i - k) {
                    dq.pollFirst();
                } else {
                    break;
                }
            }

            while (!dq.isEmpty()) {

                if (nums[dq.peekLast()] < nums[i]) {
                    dq.pollLast();
                } else {
                    break;
                }
            }

            dq.offerLast(i);

            if (i >= k - 1) {
                ans[idx] = nums[dq.peekFirst()];
                idx++;
            }
        }

        return ans;
    }
}
